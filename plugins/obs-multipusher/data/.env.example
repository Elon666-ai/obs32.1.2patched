# Tencent Cloud SRT publish keys.
#
# Copy this file to `.env` (same directory) and fill in the real values.
# `.env` is git-ignored and must never be committed. The plugin also accepts
# TX_KEY_MAIN / TX_KEY_BACK environment variables, which take precedence.
#
# Key resolution order (first match wins):
#   1. environment variable TX_KEY_MAIN / TX_KEY_BACK
#   2. conf/.env, bin/conf/.env, .env (relative to the process CWD)
#   3. <plugin data dir>/.env  (this copy, installed next to the plugin)

TX_KEY_MAIN=
TX_KEY_BACK=
